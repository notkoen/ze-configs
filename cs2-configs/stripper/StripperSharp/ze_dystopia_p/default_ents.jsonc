{
  "modify": [
    // Prevent players breaking generator early
    {
      "match": {
        "targetname": "[PR#]door41_generator",
        "classname": "func_breakable"
      },
      "insert": {
        "health": "999999"
      }
    },
    {
      "match": {
        "classname": "trigger_once",
        "hammeruniqueid": "1048"
      },
      "insert": {
        "connections": [
          {
            "output": "OnStartTouch",
            "target": "[PR#]door41_generator",
            "input": "SetHealth",
            "param": "1500",
            "delay": 0,
            "limit": 1
          }
        ]
      }
    }
  ]
}